# Google Analytics (GA4)
# Preencha com o ID de medição (formato G-XXXXXXXXXX) para ativar o Google Analytics.
# Deixe vazio ou comentado para desativar em ambiente de desenvolvimento.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook/Instagram Ads)
# Preencha com o ID do pixel para ativar o Meta Pixel.
# Deixe vazio ou comentado para desativar em ambiente de desenvolvimento.
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Agendamento online (plataforma ainda a definir: Calendly, Cal.com, Doctoralia, etc.)
# Preencha com o link de agendamento para exibir a seção "Agende sua consulta online".
# Deixe vazio ou comentado para manter a seção oculta (comportamento atual).
# NEXT_PUBLIC_BOOKING_URL=https://calendly.com/seu-usuario
